{
  "name": "browser-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "next build --webpack",
    "preview": "http-server out -a 127.0.0.1 -p 4175 -c-1",
    "test:e2e": "playwright test",
    "quality": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "vitest": "5.0.3",
    "jsdom": "27.2.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0",
    "http-server": "14.1.1"
  }
}
